# Server port (Render sets this automatically; default: 8080)
PORT=8080

# Environment: "dev" or "prod"
APP_ENV=prod

# Cookie SameSite mode:
# With Cloudflare Pages proxying /api to Render, the frontend and API share the same origin (*.pages.dev)!
# Therefore, standard first-party "lax" is recommended and works across all browsers.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Database connection:
# - On Render, DATABASE_URL is automatically provided by the linked database
# - For Docker Compose / local dev, PG_URL is used
DATABASE_URL=postgres://user:password@hostname:5432/mnnit_chess_club?sslmode=require
PG_URL=postgres://user:password@localhost:5432/mnnit_chess_club?sslmode=disable

# Base URL for API callbacks (via Cloudflare Pages proxy):
# e.g., https://<your-project>.pages.dev/api
BASE_URL=https://mnnitchessclub.pages.dev/api

# Frontend URL on Cloudflare Pages (without trailing slash):
# e.g., https://<your-project>.pages.dev
FRONTEND_URL=https://mnnitchessclub.pages.dev

# Allowed origins for CORS (comma-separated):
CORS_ALLOWED_ORIGINS=https://mnnitchessclub.pages.dev,http://localhost:5173

# Google OAuth Credentials (add BASE_URL/auth/callback/google to Google Cloud Console redirect URIs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
