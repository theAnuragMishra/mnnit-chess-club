# Server port (Render sets this automatically; default: 8080)
PORT=8080

# Environment: "dev" or "prod"
APP_ENV=prod

# Cookie SameSite mode:
# - "none": REQUIRED for cross-domain hosting (e.g. Cloudflare Pages frontend + Render API)
# - "strict" or "lax": for same-domain hosting (e.g. Docker Compose + Caddy on VPS)
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Database connection:
# - On Render, DATABASE_URL is automatically provided by the linked database
# - For Docker Compose / local dev, PG_URL is used
DATABASE_URL=postgres://user:password@hostname:5432/mnnit_chess_club?sslmode=require
PG_URL=postgres://user:password@localhost:5432/mnnit_chess_club?sslmode=disable

# Render Web Service URL (without trailing slash)
BASE_URL=https://mnnit-chess-club-api.onrender.com

# Cloudflare Pages site URL (without trailing slash)
FRONTEND_URL=https://mnnit-chess-club.pages.dev

# Optional extra origins for CORS (comma-separated):
CORS_ALLOWED_ORIGINS=https://mnnit-chess-club.pages.dev,http://localhost:5173

# Google OAuth Credentials (add BASE_URL/auth/callback/google to Google Cloud Console redirect URIs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
