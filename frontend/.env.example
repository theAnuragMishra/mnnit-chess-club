# Cloudflare Pages Proxy setup (Same-domain, first-party cookies):

# Public API Base URL: points to the /api proxy on Cloudflare Pages
PUBLIC_BASE_URL=https://mnnitchessclub.pages.dev/api

# Public WebSocket URL: points to the /api/ws proxy on Cloudflare Pages
PUBLIC_WS_URL=wss://mnnitchessclub.pages.dev/api/ws

# Frontend site URL (no trailing slash)
PUBLIC_FRONTEND_URL=https://mnnitchessclub.pages.dev

# (Cloudflare Pages environment variable for the proxy function):
# Target Render API backend
BACKEND_URL=https://mnnit-chess-club-api.onrender.com
